{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore.Database.Command": "Information",
            "System": "Warning"
        }
    },
    "Cors": {
        "AllowedOrigins": [ "https://localhost:5173", "https://192.168.100.29:5173", "https://app.csingenieria.com.ar" ]
    },
    "AllowedHosts": "*",
    "Jwt": {
        "Key": "",
        "Issuer": "",
        "Audience": ""
    },
    "ConnectionStrings": {
        "DefaultConnection": ""
    },
    "Frontend": {
        "BaseUrl": "https://app.csingenieria.com.ar"
    },
    "Security": {
        "RateLimiting": {
            "Actions": {
                "login": {
                    "Mode": "FailureTracking",
                    "MaxAttempts": 6,
                    "TimeWindowMinutes": 15,
                    "BlockDurationMinutes": 15,
                    "CaptchaRequiredAttempts": 3,
                    "ResetOnSuccess": true
                },
                "register": {
                    "Mode": "FailureTracking",
                    "MaxAttempts": 3,
                    "TimeWindowMinutes": 15,
                    "BlockDurationMinutes": 15,
                    "CaptchaAlwaysRequired": true,
                    "ResetOnSuccess": false
                },
                "forgot-password": {
                    "Mode": "FailureTracking",
                    "MaxAttempts": 3,
                    "TimeWindowMinutes": 15,
                    "BlockDurationMinutes": 15,
                    "CaptchaAlwaysRequired": true,
                    "ResetOnSuccess": false
                },
                "reset-password": {
                    "Mode": "FailureTracking",
                    "MaxAttempts": 3,
                    "TimeWindowMinutes": 15,
                    "BlockDurationMinutes": 15,
                    "CaptchaAlwaysRequired": true,
                    "ResetOnSuccess": false
                },
                "user-report": {
                    "Mode": "RateLimit",
                    "MaxAttempts": 5,
                    "TimeWindowMinutes": 15,
                    "BlockDurationMinutes": 15
                }
            },
            "Turnstile": {
                "SiteKey": "",
                "SecretKey": "",
                "VerifyUrl": "https://challenges.cloudflare.com/turnstile/v0/siteverify"
            },
            "Seed": {
                "AdminEmail": "${{ vars.SEED__ADMINEMAIL }}",
                "AdminPassword": "${{ secrets.SEED__ADMINPASSWORD }}",
                "CompanyName": "${{ vars.SEED__COMPANYNAME }}",
                "CompanyCuit": "${{ vars.SEED__COMPANYCUIT }}"
            }
        }
    }
}
