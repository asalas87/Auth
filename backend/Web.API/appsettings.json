{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore.Database.Command": "Information",
            "System": "Warning"
        }
    },
    "Cors": {
        "AllowedOrigins": [ "https://localhost:5173", "https://192.168.100.29:5173", "https://app.csingenieria.com.ar" ]
    },
    "AllowedHosts": "*",
    "Jwt": {
        "Key": "",
        "Issuer": "",
        "Audience": ""
    },
    "ConnectionStrings": {
        "DefaultConnection": ""
    },
    "Frontend": {
        "BaseUrl": "https://app.csingenieria.com.ar"
    },
    "Serilog": {
        "Using": [
            "Serilog.Sinks.Console",
            "Serilog.Sinks.File"
        ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "System": "Warning"
            }
        },
        "WriteTo": [
            {
                "Name": "Console"
            },
            {
                "Name": "File",
                "Args": {
                    "path": "Logs/log-.txt",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 30,
                    "shared": true
                }
            }
        ],
        "Enrich": [
            "FromLogContext"
        ]
    },
    "Security": {
        "RateLimiting": {
            "Actions": {
                "login": {
                    "Mode": "FailureTracking",
                    "MaxAttempts": 6,
                    "TimeWindowMinutes": 15,
                    "BlockDurationMinutes": 15,
                    "CaptchaRequiredAttempts": 3,
                    "ResetOnSuccess": true
                },
                "register": {
                    "Mode": "FailureTracking",
                    "MaxAttempts": 3,
                    "TimeWindowMinutes": 15,
                    "BlockDurationMinutes": 15,
                    "CaptchaAlwaysRequired": true,
                    "ResetOnSuccess": false
                },
                "forgot-password": {
                    "Mode": "FailureTracking",
                    "MaxAttempts": 3,
                    "TimeWindowMinutes": 15,
                    "BlockDurationMinutes": 15,
                    "CaptchaAlwaysRequired": true,
                    "ResetOnSuccess": false
                },
                "reset-password": {
                    "Mode": "FailureTracking",
                    "MaxAttempts": 3,
                    "TimeWindowMinutes": 15,
                    "BlockDurationMinutes": 15,
                    "CaptchaAlwaysRequired": true,
                    "ResetOnSuccess": false
                },
                "user-report": {
                    "Mode": "RateLimit",
                    "MaxAttempts": 5,
                    "TimeWindowMinutes": 15,
                    "BlockDurationMinutes": 15
                }
            }
        },
        "Turnstile": {
            "SiteKey": "",
            "SecretKey": "",
            "VerifyUrl": "https://challenges.cloudflare.com/turnstile/v0/siteverify"
        },
        "Seed": {
        "AdminEmail": "${{ vars.SEED_ADMIN_EMAIL }}",
        "AdminPassword": "${{ secrets.SEED_ADMIN_PASSWORD }}",
        "CompanyName": "${{ vars.SEED_COMPANY_NAME }}",
        "CompanyCuit": "${{ vars.SEED_COMPANY_CUIT }}"
        }
    }
}
